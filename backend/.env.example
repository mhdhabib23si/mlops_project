# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Model Configuration
SENTIMENT_MODEL=indobenchmark/indobert-base-p1
CATEGORY_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Hugging Face Configuration
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
USE_LLM_GPU=true  # Set to false to use CPU for LLaMA 3 (slower)
USE_SENTIMENT_GPU=true  # Set to false to use CPU for IndoBERT (slower)

# Device Configuration
DEVICE=auto  # auto, cpu, cuda

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls
